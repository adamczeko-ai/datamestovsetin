{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "x-data-files": ["data/graf_hrany.jsonl"],
 "title": "Hrana grafu entit (předávka P3i)",
 "description": "Jeden řádek data/graf_hrany.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "z",
  "c",
  "typ"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^hrana:.+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "z": {
   "type": "string"
  },
  "c": {
   "type": "string"
  },
  "typ": {
   "type": "string"
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Materiál (návrh usnesení) pro zasedání ZM",
 "description": "Jeden řádek data/materialy_zm.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "id_dokumenty_balicku",
  "soubor"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^material_zm:\\d+:.+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "zasedani": {
   "type": [
    "integer",
    "null"
   ]
  },
  "id_dokumenty_balicku": {
   "type": "integer"
  },
  "soubor": {
   "type": "string"
  },
  "vec": {
   "type": [
    "string",
    "null"
   ]
  },
  "predklada_funkcionar": {
   "enum": [
    null,
    "[FO]"
   ]
  },
  "usneseni_cislo": {
   "type": [
    "string",
    "null"
   ]
  },
  "text": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Uzel grafu entit (předávka P3i)",
 "description": "Jeden řádek data/graf_uzly.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "typ"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^(subjekt|usneseni|zakazka|projekt):.+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "typ": {
   "enum": [
    "subjekt",
    "usneseni",
    "zakazka",
    "projekt"
   ]
  },
  "label": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
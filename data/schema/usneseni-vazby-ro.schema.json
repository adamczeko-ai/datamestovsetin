{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "x-data-files": ["data/usneseni/usneseni_vazby_RO.json"],
 "title": "Vazby usnesení ZM/RM na rozpočtová opatření + indexy zasedání",
 "description": "data/usneseni/usneseni_vazby_RO.json",
 "type": "object",
 "required": [
  "schema",
  "vytezeno",
  "index_ZM",
  "index_RM_2026"
 ],
 "properties": {
  "schema": {
   "type": "string"
  },
  "vytezeno": {
   "type": "string"
  },
  "zdroje": {
   "type": "object"
  },
  "zaver": {
   "type": "string"
  },
  "index_ZM": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "zasedani",
     "datum",
     "id_dokumenty"
    ],
    "properties": {
     "zasedani": {
      "type": "integer",
      "minimum": 1
     },
     "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "id_dokumenty": {
      "type": "integer"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   },
   "minItems": 1
  },
  "index_RM_2026": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "schuze",
     "datum",
     "id_dokumenty"
    ],
    "properties": {
     "schuze": {
      "type": "integer",
      "minimum": 1
     },
     "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "id_dokumenty": {
      "type": "integer"
     }
    }
   }
  },
  "zjisteni": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "usneseni",
     "datum",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^U-\\d+$"
     },
     "usneseni": {
      "type": "string"
     },
     "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "ro": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "dusledek": {
      "type": "string"
     },
     "vazba_RO": {
      "type": "string"
     }
    }
   }
  },
  "balicky_ZM": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "zasedani",
     "datum",
     "id_dokumenty"
    ],
    "properties": {
     "zasedani": {
      "type": "integer"
     },
     "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "id_dokumenty": {
      "type": "integer"
     },
     "format": {
      "type": "string"
     }
    }
   }
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Usnesení Rady (RM, RMZ) a Zastupitelstva (ZM) města Vsetín",
 "description": "Jeden řádek data/usneseni.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "cislo",
  "org",
  "id_dokumenty",
  "nazev",
  "vyroky",
  "ico",
  "castky"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^usneseni:\\d+:\\d+/\\d+/(RM|RMZ|ZM)/\\d{4}(~\\d+)?$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "cislo": {
   "type": "string",
   "pattern": "^\\d+/\\d+/(RM|RMZ|ZM)/\\d{4}$"
  },
  "org": {
   "enum": [
    "RM",
    "RMZ",
    "ZM"
   ]
  },
  "id_dokumenty": {
   "type": "integer"
  },
  "datum": {
   "type": [
    "string",
    "null"
   ]
  },
  "nazev": {
   "type": "string"
  },
  "text": {
   "type": [
    "string",
    "null"
   ]
  },
  "vyroky": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "ico": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^(\\d{8}|FO-[0-9a-f]{12}|FO-\\d{4,})$"
   }
  },
  "castky": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "kategorie": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Subjekt (IČO) ověřený v ARES",
 "description": "Jeden řádek data/subjekty_ares.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "ico",
  "kontrolni_cislice_ok",
  "fyzicka_osoba"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^ico:(\\d{8}|FO-[0-9a-f]{12}|FO-\\d{4,})$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "ico": {
   "type": "string",
   "pattern": "^(\\d{8}|FO-[0-9a-f]{12}|FO-\\d{4,})$",
   "description": "IČO; u OSVČ pseudonym FO-… (§ 5, integrace/sber/ico_fo.py)"
  },
  "kontrolni_cislice_ok": {
   "type": "boolean"
  },
  "fyzicka_osoba": {
   "type": "boolean"
  },
  "obchodni_jmeno": {
   "type": [
    "string",
    "null"
   ]
  },
  "pravni_forma": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
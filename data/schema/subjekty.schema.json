{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Registr subjektů",
 "type": "object",
 "required": [
  "subjekty"
 ],
 "properties": {
  "subjekty": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "nazev"
    ],
    "properties": {
     "ico": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{8}$"
     },
     "nazev": {
      "type": "string"
     },
     "role": {
      "type": "string"
     }
    }
   }
  }
 }
}
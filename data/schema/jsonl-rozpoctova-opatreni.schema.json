{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Rozpočtové opatření (dokument)",
 "description": "Jeden řádek data/rozpoctova_opatreni.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "rok",
  "id_dokumenty",
  "polozky"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^ro:\\d+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "rok": {
   "type": "integer",
   "minimum": 2000
  },
  "cislo": {
   "type": [
    "integer",
    "null"
   ]
  },
  "schvaluje": {
   "enum": [
    null,
    "RM",
    "ZM"
   ]
  },
  "id_dokumenty": {
   "type": "integer"
  },
  "polozky": {
   "type": "array"
  }
 }
}
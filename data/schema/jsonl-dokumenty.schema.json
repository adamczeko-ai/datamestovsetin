{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dokument stažený z webu města (soubor File.ashx)",
 "description": "Jeden řádek data/dokumenty.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "id_dokumenty",
  "typ",
  "kvalita_textu"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^dok:\\d+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "id_dokumenty": {
   "type": "integer"
  },
  "typ": {
   "type": "string"
  },
  "titul": {
   "type": [
    "string",
    "null"
   ]
  },
  "zverejneno": {
   "type": [
    "string",
    "null"
   ]
  },
  "zdroj_sha256": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{64}$"
  },
  "bajty": {
   "type": [
    "integer",
    "null"
   ]
  },
  "kvalita_textu": {
   "type": "string"
  },
  "text": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "x-data-files": ["data/uredni_deska_snimky.jsonl"],
 "title": "Snímek úřední desky (seznam dokumentů v okamžiku běhu)",
 "description": "Jeden řádek data/uredni_deska_snimky.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "id_dokumenty",
  "pocet"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^ud_snimek:.+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "id_dokumenty": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "pocet": {
   "type": "integer"
  }
 }
}
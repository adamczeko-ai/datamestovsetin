{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Usnesení o výběru dodavatele (předávka P1d v2)",
 "description": "Jeden řádek data/vyber_dodavatele.jsonl. Společná pole: id, source_url, retrieved_at (Europe/Prague), sha256 (obsahový otisk, integrace/sber/store.py).",
 "type": "object",
 "required": [
  "id",
  "source_url",
  "retrieved_at",
  "sha256",
  "cislo_usneseni"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^vd:.+$"
  },
  "source_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d[+-]\\d\\d:\\d\\d$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "puvod": {
   "type": "object",
   "required": [
    "repo",
    "vetev",
    "commit",
    "soubor"
   ],
   "properties": {
    "commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "cislo_usneseni": {
   "type": "string"
  },
  "vitez_ico": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
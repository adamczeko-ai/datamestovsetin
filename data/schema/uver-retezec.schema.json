{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Řetězec úvěru: usnesení → smlouva → RO → MONITOR",
 "description": "data/smlouvy/uver_CSOB_2026.json, data/smlouvy/uver_CSOB_kontokorent_2011.json. datum = původní hodnota (ISO, výjimečně text „neuvedeno (…)“), datum_iso = ISO 8601 nebo null (scripts/normalizace_dat.py).",
 "type": "object",
 "required": [
  "schema",
  "id",
  "nazev",
  "vytezeno",
  "retezec",
  "zjisteni"
 ],
 "properties": {
  "schema": {
   "type": "string"
  },
  "id": {
   "type": "string"
  },
  "nazev": {
   "type": "string"
  },
  "vytezeno": {
   "type": "string"
  },
  "retezec": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "datum",
     "typ",
     "id",
     "text",
     "zdroj",
     "datum_iso"
    ],
    "properties": {
     "datum": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|neuvedeno.*)$"
     },
     "typ": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "zdroj": {
      "type": "string"
     },
     "overeni": {
      "type": "string"
     },
     "priloha": {
      "type": "string"
     },
     "zdroj_duvodova_zprava": {
      "type": "string"
     },
     "datum_iso": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     }
    }
   },
   "minItems": 1
  },
  "zjisteni": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
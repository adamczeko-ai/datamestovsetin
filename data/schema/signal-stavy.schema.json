{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "x-data-files": ["data/analyzy/signaly_stavy.json"],
 "title": "Stavy ověření signálů",
 "description": "Soubor data/analyzy/signaly_stavy.json. Edituje ho pouze člověk (vlastník/ověřovatel). AI a generátory ho nikdy nepřepisují; AI smí jen navrhnout změnu v popisu PR.",
 "type": "object",
 "required": ["schema", "stavy"],
 "properties": {
  "schema": {"const": "vsetin-osint/signal-stavy@1"},
  "vyznam_stavu": {"type": "object"},
  "stavy": {
   "type": "object",
   "propertyNames": {"pattern": "^(S-[0-9a-f]{10}(-\\d+)?|A-\\d{4}-\\d{2})$"},
   "additionalProperties": {
    "type": "object",
    "required": ["stav", "overil", "datum", "oduvodneni"],
    "additionalProperties": false,
    "properties": {
     "stav": {"enum": ["overuje_se", "vysvetleno", "potvrzeno", "zamitnuto"]},
     "overil": {"type": "string", "minLength": 1, "description": "Kdo stav nastavil (jméno/role, nebo 'migrace')"},
     "datum": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
     "oduvodneni": {"type": "string", "minLength": 3},
     "dukazy_overeni": {"type": "array", "items": {"type": "string"}},
     "druhe_overeni": {"type": ["string", "null"], "description": "Princip čtyř očí: kdo stav nezávisle potvrdil (povinné před předáním KV/vedení)"}
    }
   }
  }
 }
}
